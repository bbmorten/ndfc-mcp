#!/usr/bin/env node
// Print ready-to-paste client configuration for THIS checkout: the real path of
// the compose file and of docker, never the API key.
//
//   bin/client-config            for compose.yaml (with the VPN sidecar)
//   bin/client-config direct     for compose.direct.yaml
//
// On Windows: bin\client-config [direct]   (client-config.cmd starts this file).
// The command lines it prints there are for PowerShell, the paths are Windows
// paths, and the JSON blocks carry them escaped.
//
// CommonJS and no dependencies, like ../setup.
"use strict";

const fs = require("node:fs");
const path = require("node:path");

const WINDOWS = process.platform === "win32";
const HERE = path.resolve(__dirname, "..");
const FILE = path.join(HERE, process.argv[2] === "direct" ? "compose.direct.yaml" : "compose.yaml");
const ENV = path.join(HERE, ".env");

/** The full path of an executable on PATH, or null. */
function findExe(name) {
  const exts = WINDOWS ? (process.env.PATHEXT || ".EXE;.CMD;.BAT").split(";") : [""];
  for (const dir of (process.env.PATH || "").split(path.delimiter)) {
    if (!dir) continue;
    for (const ext of exts) {
      const p = path.join(dir, name + ext);
      try {
        if (fs.statSync(p).isFile()) return p;
      } catch {}
    }
  }
  return null;
}

/** One setting from .env, when there is one. Only the port and the access level are read from it. */
function envValue(name) {
  let text = "";
  try {
    text = fs.readFileSync(ENV, "utf8");
  } catch {}
  const m = new RegExp(`^${name}=(.*)$`, "m").exec(text);
  return m ? m[1].trim().replace(/^(['"])(.*)\1$/, "$2") : "";
}
const hostPort = () => envValue("NDFC_MCP_HOST_PORT") || "3300";
// What a client shows for the server: the write tools are named when .env turns them on.
const DESCRIPTION =
  envValue("NDFC_MCP_ACCESS") === "write"
    ? "Cisco NDFC: reads fabrics, switches, interfaces, links, policies, alarms; creates, attaches and deploys VRFs and networks"
    : "Read-only Cisco NDFC: fabrics, switches, interfaces, links, policies, alarms";

const DOCKER = findExe("docker") || "docker";
const PORT = hostPort();
const RULE = "─".repeat(72);
const json = (s) => JSON.stringify(s);
const stdioArgs = `["compose", "-f", ${json(FILE)}, "exec", "-T", "ndfc-mcp", "node", "/app/stdio.mjs"]`;

// The two Claude Code command lines are shell syntax, so they differ by platform.
// PowerShell drops a bare -- on the way to claude's .ps1 launcher: it is quoted.
const psQuote = (s) => `'${s.replace(/'/g, "''")}'`;
const codeStdio = WINDOWS
  ? `claude mcp add --transport stdio ndfc '--' "${DOCKER}" compose -f "${FILE}" exec -T ndfc-mcp node /app/stdio.mjs`
  : `claude mcp add --transport stdio ndfc -- "${DOCKER}" compose -f "${FILE}" exec -T ndfc-mcp node /app/stdio.mjs`;
const codeHttpTitle = WINDOWS
  ? "Claude Code — over HTTP (PowerShell; the key is read from .env)"
  : "Claude Code — over HTTP (run from this directory; the key is read from .env)";
const codeHttp = WINDOWS
  ? `claude mcp add --transport http ndfc http://127.0.0.1:${PORT}/mcp \`
  --header "X-Api-Key: $((Select-String -Path ${psQuote(ENV)} -Pattern '^NDFC_MCP_API_KEY=(.*)').Matches[0].Groups[1].Value)"`
  : `claude mcp add --transport http ndfc http://127.0.0.1:${PORT}/mcp \\
  --header "X-Api-Key: $(grep -E '^NDFC_MCP_API_KEY=' "${ENV}" | cut -d= -f2-)"`;

process.stdout.write(`${RULE}
Claude Code — over stdio (no key on the client)
${RULE}
${codeStdio}

${RULE}
${codeHttpTitle}
${RULE}
${codeHttp}

${RULE}
Claude Desktop — add under "mcpServers" in claude_desktop_config.json
${RULE}
"ndfc": {
  "command": ${json(DOCKER)},
  "args": ${stdioArgs}
}

${RULE}
aimo for VS Code — settings.json, over stdio (read-only tools run without asking)
${RULE}
"aimo.mcp.local.enabled": true,
"aimo.mcp.local.servers": {
  "ndfc": {
    "type": "stdio",
    "command": "docker",
    "args": ${stdioArgs},
    "description": ${json(DESCRIPTION)}
  }
}

${RULE}
aimo for VS Code — settings.json, over HTTP (then store the key, see below)
${RULE}
"aimo.mcp.local.enabled": true,
"aimo.mcp.local.servers": {
  "ndfc": {
    "type": "http",
    "url": "http://127.0.0.1:${PORT}/mcp",
    "headers": { "X-Api-Key": "\${secret:ndfc-api-key}" },
    "description": ${json(DESCRIPTION)}
  }
}
  Then: Command Palette → "AIMO: Set Local Server Secret" → id  ndfc-api-key
  → paste the value of NDFC_MCP_API_KEY from ${ENV}
`);
