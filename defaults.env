# defaults.env — the values this project runs with, offered as defaults by ./setup.
#
# COMMITTED ON PURPOSE (the owner's decision, 2026-11-12): it carries the lab's
# credentials — the server's API key, the controller login and the VPN login of
# the Cisco DevNet sandbox reservation. Anyone who can read this repository can
# read them. Do not put a production controller's credentials here.
#
# ./setup reads, lowest to highest: .env.example, this file, then .env (this
# checkout's own) — and writes .env. Docker Compose never reads this file.
#
# The DevNet VPN login changes with every reservation: when the tunnel will not
# come up, the VPN_* values below are stale — take the new ones from the
# reservation's page.

# How this machine reaches the controller: vpn (compose.yaml, the sidecar) or
# direct (compose.direct.yaml). Read by ./setup only.
NDFC_MCP_COMPOSE=vpn

NDFC_MCP_API_KEY=13e8271abf8e4b243e505580642e2ba49ef6dcad0c3f0284
NDFC_URL=https://10.10.20.60
NDFC_USERNAME=admin
NDFC_PASSWORD='1vtG@lw@y'
NDFC_TLS_INSECURE=true

# The VPN sidecar (compose.yaml). Fill these in from the reservation's VPN access details.
VPN_SERVER=devnetsandbox-usw1-reservation.cisco.com:20274
VPN_USERNAME=bulent
VPN_PASSWORD='XC6fr*2&l$H76b'
