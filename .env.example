# Copy to .env and fill in. .env is git-ignored; never commit it.
#
# QUOTING: Docker Compose expands $NAME inside unquoted and "double-quoted"
# values. Put a value that contains a $ in 'single quotes'.

# ── The MCP server ───────────────────────────────────────────────────────────
# The key every client must send. Generate one:  openssl rand -hex 24
NDFC_MCP_API_KEY=REPLACE_ME_with_the_output_of_openssl_rand_hex_24

# What the server may do on the controller. Leave it out (or "read") and the
# server is read-only: the write tools are not offered and it cannot send a
# change. "write" also offers the tools that create, attach, deploy and delete
# VRFs and networks — deploying configures switches. In local mode whoever
# holds the key above may then use them.
# NDFC_MCP_ACCESS=write

# The controller (Nexus Dashboard) and ONE account the server uses on it.
# Use a read-only account (NDFC role network-operator) on a real controller,
# unless NDFC_MCP_ACCESS=write: then the account needs a role that may write
# (network-admin), and everyone with write access here acts as that account.
# The DevNet sandbox values are on its "Access details" table (row "ndfc").
NDFC_URL=https://10.10.20.60
NDFC_USERNAME=REPLACE_ME_controller_username
NDFC_PASSWORD='REPLACE_ME_controller_password'

# TLS to the controller. Nexus Dashboard's certificate is issued by its own CA,
# so choose ONE of these two (README, "The controller's certificate"):
#   pin the CA — paste the line printed by
#       docker compose exec -T ndfc-mcp node /app/pin-ca.mjs
#   or, for a lab only, skip verification:
# NDFC_TLS_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
NDFC_TLS_INSECURE=true

# The port on THIS machine (127.0.0.1 only). Change it if 3300 is taken.
# NDFC_MCP_HOST_PORT=3300

# ── The VPN sidecar (compose.yaml only; compose.direct.yaml ignores these) ───
# The gateway, as your VPN client shows it: host or host:port.
# The DevNet sandbox shows them on the reservation's page, under VPN access.
VPN_SERVER=REPLACE_ME_vpn_host:port
VPN_USERNAME=REPLACE_ME_vpn_username
VPN_PASSWORD='REPLACE_ME_vpn_password'

# Optional.
# VPN_PROTOCOL=anyconnect        # anyconnect (default) | gp | pulse | fortinet | nc | f5
# VPN_AUTHGROUP=                 # the group / tunnel-group, if the gateway asks for one
# VPN_SERVERCERT=                # pin-sha256:… for a gateway with a private certificate
# VPN_EXTRA_ARGS=                # more openconnect arguments
# VPN_HEALTH_URL=https://10.10.20.60/version.json   # also require this to answer before the server starts
